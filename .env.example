# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# --- PostgreSQL ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# --- FRED Economic Data ---
FRED_API_KEY=

# --- AWS S3 Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- Snowflake ---
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=

# --- Google BigQuery ---
# The GCP project that owns the BigQuery dataset.
BIGQUERY_PROJECT_ID=

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Alerts & Notifications ---
DISCORD_WEBHOOK_URL=

