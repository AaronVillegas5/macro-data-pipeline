# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# --- PostgreSQL ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# --- FRED Economic Data ---
FRED_API_KEY=

# --- AWS S3 Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- Snowflake ---
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=

# --- Google BigQuery ---
# The GCP project that owns the BigQuery dataset.
BIGQUERY_PROJECT_ID=

# ADC (Application Default Credentials) is used automatically by the
# google-cloud-bigquery client. Run the following once to authenticate:
#   gcloud auth application-default login
# Or point to a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
